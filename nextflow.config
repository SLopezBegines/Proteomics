/*
 * Proteomics DEP pipeline: default configuration.
 * Run `nextflow run . --help`-style documentation lives in the README.
 */

manifest {
    name            = 'SLopezBegines/Proteomics'
    description     = 'Label-free LFQ proteomics (MaxQuant) differential analysis with DEP/limma'
    author          = 'Santiago López-Begines'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '0.1.0'
}

params {
    // ---- Input ----
    protein_groups   = null          // MaxQuant proteinGroups (.txt/.tsv/.csv) or pre-processed .xlsx
    design           = null          // CSV: label,condition,replicate[,batch]
    contrasts        = null          // "A_vs_B,A_vs_C"; default: all pairwise contrasts
    dataset          = 'proteomics'  // used for the output sub-directory
    organism         = 'human'       // human | mouse | zebrafish

    // ---- Filtering / imputation ----
    fraction_na      = 0.6           // max fraction of missing values tolerated per condition
    mnar_var         = 'zero'        // MNAR imputation: zero | MinProb | QRILC
    factor_sd_impute = 0.05          // width of the MNAR imputation distribution
    factor_sd_scale  = 0.3

    // ---- Differential expression / significance ----
    adjusted_method  = 'BH'          // BH | BY | bonferroni | holm | fdr | none
    p_val            = 0.05          // significance threshold
    p_val_low        = 0.01          // stricter threshold
    fc               = 0.5           // minimum |log2 fold change|

    // ---- Plots ----
    barplots         = false         // per-protein barplots (slow on large datasets)

    // ---- Output / runtime ----
    outdir           = 'results'
    publish_dir_mode = 'copy'
    container        = 'proteomics-dep:r4.5.3-bioc3.22'   // local tag; override with a registry URL or a .sif path
}

includeConfig 'conf/base.config'

// Docker is the default container engine; the singularity and slurm profiles switch it off.
docker.enabled    = true
docker.runOptions = '-u $(id -u):$(id -g)'

profiles {
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
    singularity {
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

process.container = params.container

timeline {
    enabled   = true
    file      = "${params.outdir}/${params.dataset}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/${params.dataset}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/${params.dataset}/pipeline_info/execution_trace.tsv"
    overwrite = true
}

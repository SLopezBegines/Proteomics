/*
 * SLURM template. NOT tested (no cluster available when this was written): adapt queue,
 * account and module/Singularity settings to your site before use.
 *
 *   nextflow run . -profile singularity,slurm \
 *       --protein_groups proteinGroups.txt --design design.csv \
 *       --container /shared/containers/proteomics-dep.sif
 *
 * Build the .sif from the Docker image on a machine that has both, e.g.:
 *   docker save proteomics-dep:r4.5.3-bioc3.22 -o proteomics-dep.tar
 *   singularity build proteomics-dep.sif docker-archive://proteomics-dep.tar
 */
params {
    slurm_queue   = null        // e.g. 'short'
    slurm_account = null        // e.g. 'my_project'
}

process {
    executor = 'slurm'
    queue    = params.slurm_queue
    clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
    resourceLimits = [cpus: 16, memory: 64.GB, time: 24.h]   // site limits
}

executor {
    queueSize         = 20
    submitRateLimit   = '10 sec'
    pollInterval      = '30 sec'
}

docker.enabled = false

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${projectDir}/.singularity_cache"
}

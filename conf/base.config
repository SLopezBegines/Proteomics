/*
 * Resource requests per process label. The R steps are memory-bound rather than CPU-bound.
 * A task killed by the kernel (exit 137/140, usually out of memory) is retried once with double memory.
 */
process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = 1.h
    }
    withLabel: process_medium {
        cpus   = 2
        memory = { 6.GB * task.attempt }
        time   = 4.h
    }
    withLabel: process_high_memory {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = 8.h
    }
}

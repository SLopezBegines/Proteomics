/*
 * Minimal test: a 600-protein subset of PXD031582 (CLN3 interactome, 12 LFQ samples).
 * The subset is not versioned; generate it with bin/make_test_data.R (see README).
 *   nextflow run . -profile test
 */
params {
    protein_groups = "${projectDir}/testdata/proteinGroups_PXD031582_subset.tsv"
    design         = "${projectDir}/assets/design_PXD031582.csv"
    dataset        = 'PXD031582_test'
    organism       = 'human'
    outdir         = 'results'
}

process {
    // keep the test within a laptop: caps whatever the labels ask for
    resourceLimits = [cpus: 4, memory: 10.GB, time: 2.h]
}
